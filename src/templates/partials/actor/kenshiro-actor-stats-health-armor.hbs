<div class="kenshiro-body-map-section">
    <h3>{{localize "KENSHIRO.Stats.Health"}} {{localize "Various.And"}} {{localize "KENSHIRO.Stats.Armor"}}</h3>

    <div class="body-map-wrapper">
        <div class="body-silhouette"></div>

        <div class="location-group head">
            <label class="armor-box-label">
                <span class="location-tag">{{localize "KENSHIRO.Stats.Locations.Shortened.Head"}}</span>
                <span class="armor-inputs-flex">
                                <input type="number"
                                       name="system.hitLocations.head.armor"
                                       value="{{system.hitLocations.head.armor}}"
                                       class="input-arm-phys" title="{{localize "KENSHIRO.Stats.Armor"}}"
                                       data-dtype="Number"/>
                                <input type="number"
                                       name="system.hitLocations.head.maArmor"
                                       value="{{system.hitLocations.head.maArmor}}"
                                       class="input-arm-martial" title="{{localize "KENSHIRO.Stats.Marmor"}}"
                                       data-dtype="Number"/>
                            </span>
            </label>
            <div class="circles-container head-circles">
                {{#each system.hitLocations.head.hitPoints}}
                    <span class="circles-item"
                          data-action="cycleHealth"
                          data-location="head"
                          data-index="{{@index}}"
                          data-state="{{this}}"
                          title="{{localize (concat "Various.Health.Status" " " this)}} {{localize
                                  "Various.Click"}}"
                    ></span>
                {{/each}}
            </div>
        </div>
        <div class="location-group body">
            <label class="armor-box-label">
                <span class="location-tag">{{localize "KENSHIRO.Stats.Locations.Shortened.Body"}}</span>
                <span class="armor-inputs-flex">

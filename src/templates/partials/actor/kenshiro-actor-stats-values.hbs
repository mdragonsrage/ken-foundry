<div class="kenshiro-stats-left-column stats-layout">
    <div class="stats-grid row-1">
        <div class="stat-box">
            <h3>{{localize "KENSHIRO.Stats.TitleComponent"}}</h3>
            <div class="fields-list">
                {{#each system.components as |val key|}}
                    <div class="stat-row-input">
                        <label class="stat-label-wrap">
                            <i class="{{lookup ../statIcons key}} stat-icon"></i>
                            <span class="stat-text text-capitalize">
                                {{localize (concat "KENSHIRO.Stats.Components." (capitalize key))}}
                            </span>
                            <input type="number" name="system.components.{{key}}" value="{{val}}"
                                   data-dtype="Number"/>
                        </label>
                    </div>
                {{/each}}
            </div>
        </div>

        <div class="stat-box">
            <h3>{{localize "KENSHIRO.Stats.TitleAbility"}}</h3>
            <div class="fields-list">
                {{#each system.abilities as |val key|}}
                    <div class="stat-row-input">
                        <label class="stat-label-wrap">
                            <i class="{{lookup ../statIcons key}} stat-icon"></i>
                            <span class="stat-text text-capitalize">
                                {{localize (concat "KENSHIRO.Stats.Abilities." (capitalize key))}}
                            </span>
                            <input type="number" name="system.abilities.{{key}}" value="{{val}}"
                                   data-dtype="Number"/>
                        </label>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>

    <div class="stats-grid row-2">
        <div class="stat-box full-width">
            <h3>{{localize "KENSHIRO.Stats.TitleReigns"}}</h3>
            <div class="fields-grid-three">
                {{#each system.reigns as |val key|}}
                    <div class="stat-row-input">
                        <label class="stat-label-wrap">
                            <i class="{{lookup ../statIcons key}} stat-icon"></i>
                            <span class="stat-text text-capitalize">
                                {{localize (concat "KENSHIRO.Stats.Reigns." (capitalize key))}}
                            </span>
                            {{#if (eq key "void")}}
                                <input type="number" name="system.reigns.{{key}}" value="{{val}}"
                                       disabled class="disabled-fixed"/>
                            {{else}}
                                <input type="number" name="system.reigns.{{key}}" value="{{val}}"
                                       data-dtype="Number"/>
                            {{/if}}
                        </label>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>

    <div class="stats-grid row-3">
        <div class="stat-box">
            <h3>{{localize "KENSHIRO.Stats.TitleEnergies"}}</h3>
            <div class="fields-list">
                {{#each system.energies as |val key|}}
                    <div class="stat-row-input">
                        <label class="stat-label-wrap">
                            <i class="{{lookup ../statIcons key}} stat-icon"></i>
                            <span class="stat-text text-capitalize">
                                {{localize (concat "KENSHIRO.Stats.Energies." (capitalize key))}}
                            </span>
                            <input type="number" name="system.energies.{{key}}" value="{{val}}"
                                   data-dtype="Number"/>
                        </label>
                    </div>
                {{/each}}
            </div>
        </div>

        <div class="stat-box">
            <h3>{{localize "KENSHIRO.Stats.TitleTechniques"}}</h3>
            <div class="fields-list">
                {{#each system.techniques as |val key|}}
                    <div class="stat-row-input">
                        <label class="stat-label-wrap">
                            <i class="{{lookup ../statIcons key}} stat-icon"></i>
                            <span class="stat-text text-capitalize">
                                {{localize (concat "KENSHIRO.Stats.Techniques." (capitalize key))}}
                            </span>
                            <input type="number" name="system.techniques.{{key}}" value="{{val}}"
                                   data-dtype="Number"/>
                        </label>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>
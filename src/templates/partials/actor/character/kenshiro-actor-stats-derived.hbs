<div class="kenshiro-derived-row">
    <div class="derived-grid row-1">
        <div class="derived-box">
            <h3>{{localize "KENSHIRO.Stats.DerivedDataLabels.DerivedMoves"}}</h3>
            <div class="fields-list">
                <div class="derived-row-input">
                    <label class="derived-label-wrap">
                        <span class="derived-text text-capitalize">
                            {{localize "KENSHIRO.Derived.Initiative"}}
                        </span>
                        <input type="number" name="system.derived.initiative"
                            value="{{system.derived.initiative}}"
                            data-dtype="Number"
                            disabled />
                    </label>
                </div>
                <div class="derived-row-input">
                    <label class="derived-label-wrap">
                        <span class="derived-text text-capitalize">
                            {{localize "KENSHIRO.Derived.Movement"}}
                        </span>
                        <input type="number" name="system.derived.movement"
                               value="{{system.derived.movement}}"
                               data-dtype="Number"
                               disabled />
                    </label>
                </div>
                <div class="derived-row-input">
                    <label class="derived-label-wrap">
                        <span class="derived-text text-capitalize">
                            {{localize "KENSHIRO.Derived.Run"}}
                        </span>
                        <input type="number" name="system.derived.run"
                               value="{{system.derived.run}}"
                               data-dtype="Number"
                               disabled />
                    </label>
                </div>
            </div>
        </div>
        <div class="derived-box">
            <h3>{{localize "KENSHIRO.Stats.DerivedDataLabels.DerivedAtk"}}</h3>
            <div class="fields-list">
                <div class="derived-row-input">
                    <label class="derived-label-wrap">
                        <span class="derived-text text-capitalize">
                            {{localize "KENSHIRO.Derived.Atk.HandToHand"}} {{localize "KENSHIRO.Derived.Atk.Physical"}}
                        </span>
                        <input type="number" name="system.derived.atk.physicalHandToHand"
                               value="{{system.derived.atk.physicalHandToHand}}"
                               data-dtype="Number"
                               disabled />
                    </label>
                </div>
                <div class="derived-row-input">
                    <label class="derived-label-wrap">
                        <span class="derived-text text-capitalize">
                            {{localize "KENSHIRO.Derived.Atk.HandToHand"}} {{localize "KENSHIRO.Derived.Atk.Mechanical"}}
                        </span>
                        <input type="number" name="system.derived.atk.mechanicalHandToHand"
                               value="{{system.derived.atk.mechanicalHandToHand}}"
                               data-dtype="Number"
                               disabled />
                    </label>
                </div>
                <div class="derived-row-input">
                    <label class="derived-label-wrap">
                        <span class="derived-text text-capitalize">
                            {{localize "KENSHIRO.Derived.Atk.Ranged"}} {{localize "KENSHIRO.Derived.Atk.Physical"}}
                        </span>
                        <input type="number" name="system.derived.atk.physicalRanged"
                               value="{{system.derived.atk.physicalRanged}}"
                               data-dtype="Number"
                               disabled />
                    </label>
                </div>
                <div class="derived-row-input">
                    <label class="derived-label-wrap">
                        <span class="derived-text text-capitalize">
                            {{localize "KENSHIRO.Derived.Atk.Ranged"}} {{localize "KENSHIRO.Derived.Atk.Mechanical"}}
                        </span>
                        <input type="number" name="system.derived.atk.mechanicalRanged"
                               value="{{system.derived.atk.mechanicalRanged}}"
                               data-dtype="Number"
                               disabled />
                    </label>
                </div>
            </div>
        </div>
        <div class="derived-box">
            <h3>{{localize "KENSHIRO.Stats.DerivedDataLabels.DerivedDefense"}}</h3>
            <div class="fields-list">
                <div class="derived-row-input">
                    <label class="derived-label-wrap">
                        <span class="derived-text text-capitalize">
                            {{localize "KENSHIRO.Derived.Defense.Dodge"}}
                        </span>
                        <input type="number" name="system.derived.defense.dodge"
                               value="{{system.derived.defense.dodge}}"
                               data-dtype="Number"
                               disabled />
                    </label>
                </div>
                <div class="derived-row-input">
                    <label class="derived-label-wrap">
                        <span class="derived-text text-capitalize">
                            {{localize "KENSHIRO.Derived.Defense.Parry"}} {{localize "KENSHIRO.Derived.Defense.Physical"}}
                        </span>
                        <input type="number" name="system.derived.defense.physicalParry"
                               value="{{system.derived.defense.physicalParry}}"
                               data-dtype="Number"
                               disabled />
                    </label>
                </div>
                <div class="derived-row-input">
                    <label class="derived-label-wrap">
                        <span class="derived-text text-capitalize">
                            {{localize "KENSHIRO.Derived.Defense.Parry"}} {{localize "KENSHIRO.Derived.Defense.Mechanical"}}
                        </span>
                        <input type="number" name="system.derived.defense.mechanicalParry"
                               value="{{system.derived.defense.mechanicalParry}}"
                               data-dtype="Number"
                               disabled />
                    </label>
                </div>
            </div>
        </div>

<div class="kenshiro-tracking-bars">
    <div class="tracking-row">
        <span class="bar-label">{{localize (capitalize "KENSHIRO.Stats.Resources.DamagePoints")}}</span>
        <div class="bar-boxes-wrapper">
            <div class="bar-cell">
                <span class="box-number">{{localize (capitalize "Various.HugeAbbr")}}</span>
                <span class="track-box text-box"
                      data-action="setTrack"
                      data-root="resources"
                      data-prop="damage"
                      data-value="0"
                      data-filled="{{#if (lte 0 system.resources.damage.value)}}true{{/if}}"
                      data-locked="{{#if (lte 0 system.resources.damage.maxUnblocked)}}true{{/if}}">
                            0
                    </span>
            </div>
            <div class="bar-cell">
                <span class="box-number">{{localize (capitalize "Various.NormalAbbr")}}</span>
                <span class="track-box text-box"
                      data-action="setTrack"
                      data-root="resources"
                      data-prop="damage"
                      data-value="1"
                      data-filled="{{#if (lte 1 system.resources.damage.value ?? 0)}}true{{/if}}"
                      data-locked="{{#if (lte 1 system.resources.damage?.maxUnblocked ?? 0)}}true{{/if}}">
                            -1
                    </span>
            </div>
            <div class="bar-cell">
                <span class="box-number">{{localize (capitalize "Various.DiminutiveAbbr")}}</span>
                <span class="track-box text-box"
                      data-action="setTrack"
                      data-root="resources"
                      data-prop="damage"
                      data-value="2"
                      data-filled="{{#if (lte 2 system.resources.damage.value )}}true{{/if}}"
                      data-locked="{{#if (lte 2 system.resources.damage.maxUnblocked )}}true{{/if}}">
                            -2
                    </span>
            </div>
            <div class="bar-cell">
                <span class="box-number"></span>
                <span class="track-box text-box"
                      data-action="setTrack"
                      data-root="resources"
                      data-prop="damage"
                      data-value="3"
                      data-filled="{{#if (lte 3 system.resources.damage.value )}}true{{/if}}"
                      data-locked="{{#if (lte 3 system.resources.damage.maxUnblocked )}}true{{/if}}">
                            -3
                    </span>
            </div>
            <div class="bar-cell">
                <span class="box-number"></span>
                <span class="track-box text-box"
                      data-action="setTrack"
                      data-root="resources"
                      data-prop="damage"
                      data-value="4"
                      data-filled="{{#if (lte 4 system.resources.damage.value )}}true{{/if}}"
                      data-locked="{{#if (lte 4 system.resources.damage.maxUnblocked )}}true{{/if}}">

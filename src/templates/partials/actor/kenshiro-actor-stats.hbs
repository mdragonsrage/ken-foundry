<section class="sheet-body tab info {{tab.cssClass}}"
         data-group="primary" data-tab="stats">
    <div class="kenshiro-stats-column">
        <section data-application-part="statsVals"></section>
        <section data-application-part="health_armor"></section>
    </div>

    <section data-application-part="trackingBars"></section>

    <div class="derived-grid">
        {{resourcesMalus}}
        <h3>{{localize "KENSHIRO.Stats.DerivedData"}}</h3>
        <div class="flexrow">
            <div class="stat-box">
                <label>{{localize "KENSHIRO.Stats.DefenseValue"}}</label>
                <label>
                    <input type="number" class="disabled-input"
                           value="{{system.derivated.defense}}"
                           disabled/>
                </label>
            </div>
        </div>
    </div>
</section>

                            <input type="number"
                                   name="system.hitLocations.body.maArmor"
                                   value="{{system.hitLocations.body.maArmor}}"
                                   class="input-arm-martial" title="{{localize "KENSHIRO.Stats.Marmor"}}"
                                   data-dtype="Number"/>

                          data-locked="{{#if (lte 8 system.resources.equilibrium.maxUnblocked)}}true{{/if}}"></span>
                </div>
                <div class="bar-cell">
                    <span class="box-number">1</span>
                    <span class="track-box text-box"
                          data-action="setTrack"
                          data-root="resources"
                          data-prop="equilibrium"
                          data-value="9"
                          data-filled="{{#if (lte 9 system.resources.equilibrium.value)}}true{{/if}}"
                          data-locked="{{#if (lte 9 system.resources.equilibrium.maxUnblocked)}}true{{/if}}">-1</span>
                </div>
                <div class="bar-cell">
                    <span class="box-number"></span>
                    <span class="track-box text-box"
                          data-action="setTrack"
                          data-root="resources"
                          data-prop="equilibrium"
                          data-value="10"
                          data-filled="{{#if (lte 10 system.resources.equilibrium.value)}}true{{/if}}"
                          data-locked="{{#if (lte 10 system.resources.equilibrium.maxUnblocked)}}true{{/if}}">
                        {{localize (capitalize "Various.Coma")}}
                    </span>
                </div>
            </div>
        </div>

    </div>

    <div class="derived-grid">
        <h3>{{localize "KENSHIRO.Stats.DerivedData"}}</h3>
        <div class="flexrow">
            <div class="stat-box">
                <label>{{localize "KENSHIRO.Stats.DefenseValue"}}</label>
                <label>
                    <input type="number" class="disabled-input"
                           value="{{system.derivated.defense}}"
                           disabled/>
                </label>
            </div>
        </div>
    </div>
</section>

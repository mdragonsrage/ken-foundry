<section class="sheet-body tab info {{tab.cssClass}}"
    data-group="primary" data-tab="info">

    <div class="form-group">
        <label>Id</label>
        <input type="text" name="system.id" value="{{system.id}}" />
    </div>

    <div class="form-group">
        <label>Name</label>
        <input type="text" name="name" value="{{itemName}}" />
    </div>

    <div class="form-group">
        <label>{{localize "KENSHIRO.MartialArts.Level"}}</label>
        <select name="system.level">
            {{#each levelChoices}}
                <option value="{{this}}" {{#if (eq this ../system.level)}}selected{{/if}}>
                    {{#if (eq this null)}}
                        X
                    {{else}}
                        {{this}}
                    {{/if}}
                </option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label>{{localize "KENSHIRO.MartialArts.Type"}}</label>
        <input type="text" name="system.type" value="{{system.type}}" />
    </div>

    <div class="form-group">
        <label>{{localize "KENSHIRO.MartialArts.Cost"}}</label>
        <input type="text" name="system.cost" value="{{system.cost}}" class="font-monospace" />
    </div>

    <div class="form-group">
        <label>{{localize "KENSHIRO.MartialArts.Dmg"}}</label>
        <input type="text" name="system.dmg" value="{{system.dmg}}" class="font-monospace" />
    </div>

    <div class="form-group">
        <label>{{localize "KENSHIRO.MartialArts.Special"}}</label>
        <input type="text" name="system.special" value="{{system.special}}" class="font-monospace" />
    </div>

    <div class="form-group">
        <label>{{localize "KENSHIRO.MartialArts.Notes"}}</label>
        <input type="text" name="system.notes" value="{{system.notes}}" class="font-monospace" />
    </div>
</section>

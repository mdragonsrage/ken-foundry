<div class="kenshiro-sheet-wrapper" data-part-id="sheet">
    <header class="sheet-header">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actorName}}"
             height="64" width="64" />
        <div class="header-fields">
            <h1 class="charName">
                <label>
                    <input name="name" type="text"
                           placeholder='{{localize "KENSHIRO.NamePlaceholder"}}'
                           value="{{actorName}}" required autocomplete="off" />
                </label>
            </h1>
        </div>
    </header>

    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item {{#if (eq activeTab 'stats')}}active{{/if}}" data-tab="stats">
            <i class="fas fa-book"></i> {{localize "KENSHIRO.Stats"}}
        </a>
        <a class="item {{#if (eq activeTab 'techniques')}}active{{/if}}" data-tab="techniques">
            <i class="fas fa-fist-raised"></i> {{localize "KENSHIRO.Techniques"}}
        </a>
    </nav>

    <section class="sheet-body">
        {{!-- Section Stats --}}
        <div class="tab biography {{#if (eq activeTab 'stats')}}active{{/if}}"
             data-group="primary" data-tab="stats">
            <div class="stat-block health-block">
                <label>{{localize "KENSHIRO.Salute"}}</label>
                <div class="flexrow">
                    <input type="number" name="system.salute.value"
                           value="{{system.salute.value}}" min="0" />
                    <span> / </span>
                    <input type="number" name="system.salute.max"
                           value="{{system.salute.max}}" min="0" />
                </div>
            </div>

            {{!-- Stats Block --}}
            <div class="stats-grid">
                <div class="stat-box">
                    <label>{{localize "KENSHIRO.Forza"}}</label>
                    <div class="flexrow" style="gap: 5px;">
                        <input type="number" name="system.statistiche.forza"
                               value="{{system.statistiche.forza}}" />
                        <button type="button" data-action="throwDice"
                                data-stat="forza" class="roll-btn-small">
                            <i class="fas fa-dice"></i>
                        </button>
                    </div>
                </div>
                <div class="stat-box">
                    <label>{{localize "KENSHIRO.Destrezza"}}</label>
                    <div class="flexrow" style="gap: 5px;">
                        <input type="number" name="system.statistiche.destrezza"
                               value="{{system.statistiche.destrezza}}" />
                        <button type="button" data-action="throwDice"
                                data-stat="destrezza" class="roll-btn-small">
                            <i class="fas fa-dice"></i>
                        </button>
                    </div>
                </div>
                <div class="stat-box">
                    <label>{{localize "KENSHIRO.Mente"}}</label>
                    <div class="flexrow" style="gap: 5px;">
                        <input type="number" name="system.statistiche.mente"
                               value="{{system.statistiche.mente}}" />
                        <button type="button" data-action="throwDice"
                                data-stat="mente" class="roll-btn-small">
                            <i class="fas fa-dice"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="derived-grid">
                <h3>{{localize "KENSHIRO.DatiDerivati"}}</h3>
                <div class="flexrow" style="gap: 10px;">
                    <div class="stat-box">
                        <label>{{localize "KENSHIRO.SogliaDifesa"}}</label>
                        <input type="number" value="{{system.derivated.difesa}}"
                               disabled class="disabled-input" />
                    </div>

                    {{!-- Mostra i Punti Ki Derivati --}}
                    <div class="stat-box">
                        <label>{{localize "KENSHIRO.PuntiKi"}} (Max)</label>
                        <input type="number" value="{{system.derivated.ki.max}}"
                               disabled class="disabled-input" />
                    </div>
                </div>
            </div>
        </div>

        {{!-- Section Techniques --}}
        <div data-group="primary" data-tab="techniques"
              class="tab tecniche-segrete {{#if (eq activeTab 'techniques')}}active{{/if}}">
            <header class="section-header flexrow">
                <h3 class="section-title">{{localize "KENSHIRO.Techniques"}}</h3>
            </header>

            <ol class="items-list">
                <li class="item flexrow item-header">
                    <div class="item-name flexrow">{{localize "KENSHIRO.TechName"}}</div>
                    <div class="item-prop">{{localize "KENSHIRO.TechSchool"}}</div>
                    <div class="item-prop">{{localize "KENSHIRO.TechCost"}}</div>
                    <div class="item-prop">{{localize "KENSHIRO.TechDmg"}}</div>
                    <div class="item-controls">{{localize "KENSHIRO.TechActions"}}</div>
                </li>

                <!-- List all techniques -->
                {{#each techniques as |tech|}}
                    <li class="item flexrow" data-item-id="{{tech.id}}">
                        <div class="item-name flexrow">
                            <div class="item-image"
                                 style="background-image: url('{{tech.img}}')"></div>
                            <h4>{{tech.name}}</h4>
                        </div>

                        <div class="item-prop text-capitalize">{{tech.system.scuola}}</div>
                        <div class="item-prop ki-badge">{{tech.system.costoKi}} Ki</div>
                        <div class="item-prop font-monospace damage-formula">{{tech.system.danno}}</div>

                        <div class="item-controls flexrow">
                            <a class="item-control"
                               data-action="rollTecnica"
                               title="Lancia Danno (Roll)">
                                <i class="fas fa-dice-d20"></i>
                            </a>
                            <a class="item-control"
                               data-action="editItem"
                               title="Apri (Edit)">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a class="item-control"
                               data-action="deleteItem"
                               title="Elimina (Delete)">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </li>
                {{else}}
                    <li class="item flexrow no-items">
                        <div class="text-muted">{{localize "KENSHIRO.NoTech"}}</div>
                    </li>
                {{/each}}
            </ol>
        </div>
    </section>
</div>

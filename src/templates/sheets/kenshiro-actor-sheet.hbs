<div class="kenshiro-sheet-wrapper" data-part-id="sheet">
    <header class="sheet-header">
        <img class="profile-img" src="{{actor.img}}"
             data-edit="img" title="{{actorName}}"
             height="64" width="64" alt="{{actorName}}"/>
        <div class="header-fields">
            <h1 class="charName">
                <label>
                    <input name="name" type="text"
                           placeholder='{{localize "KENSHIRO.Info.NamePlaceholder"}}'
                           value="{{actorName}}" required autocomplete="off" />
                </label>
            </h1>
        </div>
    </header>

    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item {{#if (eq activeTab 'stats')}}active{{/if}}"
           data-tab="stats">
            <i class="fas fa-book"></i>
            <span>{{localize "KENSHIRO.Sections.Stats"}}</span>
        </a>
        <a class="item {{#if (eq activeTab 'martial-arts')}}active{{/if}}"
           data-tab="martial-arts">
            <i class="fas fa-fist-raised"></i>
            <span>{{localize "KENSHIRO.Sections.MartialArts"}}</span>
        </a>
    </nav>

    <section class="sheet-body">
        {{!-- Section Stats --}}
        <div class="tab info {{#if (eq activeTab 'stats')}}active{{/if}}"
             data-group="primary" data-tab="stats">
            <div class="stat-block health-block">
                <label>{{localize "KENSHIRO.Stats.Health"}}</label>
                <div class="flexrow">
                    <label>
                        <input type="number" name="system.health.value"
                               value="{{system.health.value}}" min="0" />
                    </label>
                    <span> / </span>
                    <label>
                        <input type="number" name="system.health.max"
                               value="{{system.health.max}}" min="0" />
                    </label>
                </div>
            </div>

            {{!-- Stats Block --}}
            <div class="stats-grid">
                <div class="stat-box">
                    <label>{{localize "KENSHIRO.Stats.Strength"}}</label>
                    <div class="flexrow" style="gap: 5px;">
                        <label>
                            <input type="number"
                                   name="system.stats.strength"
                                   value="{{system.stats.strength}}" />
                        </label>
                        <button type="button" data-action="throwDice"
                                data-stat="strength" class="roll-btn-small">
                            <i class="fas fa-dice"></i>
                        </button>
                    </div>
                </div>
                <div class="stat-box">
                    <label>{{localize "KENSHIRO.Stats.Dexterity"}}</label>
                    <div class="flexrow" style="gap: 5px;">
                        <label>
                            <input type="number" name="system.stats.dexterity"
                                   value="{{system.stats.dexterity}}" />
                        </label>
                        <button type="button" data-action="throwDice"
                                data-stat="dexterity" class="roll-btn-small">
                            <i class="fas fa-dice"></i>
                        </button>
                    </div>
                </div>
                <div class="stat-box">
                    <label>{{localize "KENSHIRO.Stats.Mind"}}</label>
                    <div class="flexrow" style="gap: 5px;">
                        <label>
                            <input type="number" name="system.stats.mind"
                                   value="{{system.stats.mind}}" />
                        </label>
                        <button type="button" data-action="throwDice"
                                data-stat="mind" class="roll-btn-small">
                            <i class="fas fa-dice"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="derived-grid">
                <h3>{{localize "KENSHIRO.Stats.DerivedData"}}</h3>
                <div class="flexrow" style="gap: 10px;">
                    <div class="stat-box">
                        <label>{{localize "KENSHIRO.Stats.DefenseValue"}}</label>
                        <label>
                            <input type="number" class="disabled-input"
                                   value="{{system.derivated.defense}}"
                                   disabled />
                        </label>
                    </div>

                    <div class="stat-box">
                        <label>{{localize "KENSHIRO.Stats.PuntiKi"}} (Max)</label>
                        <label>
                            <input type="number" class="disabled-input"
                                   value="{{system.derivated.ki.max}}"
                                    disabled />
                        </label>
                    </div>
                </div>
            </div>
        </div>

        {{!-- Section Martial Arts --}}
        <div data-group="primary" data-tab="martial-arts"
              class="tab tecniche-segrete {{#if (eq activeTab 'martial-arts')}}active{{/if}}">
            <header class="section-header flexrow">
                <h3 class="section-title">
                    <span>{{localize "KENSHIRO.Sections.MartialArts"}}</span>
                </h3>
            </header>

            <ol class="martial-arts-list">
                <li class="martial-art flexrow martial-art-header">
                    <div class="martial-art-name flexrow">
                        <span>{{localize "KENSHIRO.MartialArts.Name"}}</span>
                    </div>
                    <div class="martial-art-prop">
                        <span>{{localize "KENSHIRO.MartialArts.School"}}</span>
                    </div>
                    <div class="martial-art-prop">
                        <span>{{localize "KENSHIRO.MartialArts.Cost"}}</span>
                    </div>
                    <div class="martial-art-prop">
                        <span>{{localize "KENSHIRO.MartialArts.Dmg"}}</span>
                    </div>
                    <div class="martial-art-controls">
                        <span>{{localize "KENSHIRO.MartialArts.Actions"}}</span>
                    </div>
                </li>

                <!-- List all martial-arts -->
                {{#each martialArts as |ma|}}
                    <li class="martial-art flexrow" data-item-id="{{ma.id}}">
                        <div class="martial-art-name flexrow">
                            <div class="martial-art-image"
                                 style="background-image: url('{{tech.img}}')"></div>
                            <h4>{{ma.name}}</h4>
                        </div>

                        <div class="martial-art-prop text-capitalize">
                            <span>{{ma.system.scuola}}</span>
                        </div>
                        <div class="martial-art-prop ki-badge">
                            <span>{{ma.system.costoKi}} Ki</span>
                        </div>
                        <div class="martial-art-prop font-monospace damage-formula">
                            <span>{{ma.system.danno}}</span>
                        </div>

                        <div class="martial-art-controls flexrow">
                            <a class="martial-art-control"
                               data-action="rollMartialArt"
                               title='{{localize "KENSHIRO.MartialArts.RollDamage"}}'>
                                <i class="fas fa-dice-d20"></i>
                            </a>
                            <a class="martial-art-control"
                               data-action="editMartialArt"
                               title='{{localize "KENSHIRO.MartialArts.Edit"}}'>
                                <i class="fas fa-edit"></i>
                            </a>
                            <a class="martial-art-control"
                               data-action="deleteMartialArt"
                               title='{{localize "KENSHIRO.MartialArts.Delete"}}'>
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </li>
                {{else}}
                    <li class="martial-art flexrow no-martial-arts">
                        <div class="text-muted">
                            <span>{{localize "KENSHIRO.MartialArts.Empty"}}</span>
                        </div>
                    </li>
                {{/each}}
            </ol>
        </div>
    </section>
</div>
